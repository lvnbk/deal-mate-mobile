{
  "expo": {
    "name": "DealMate",
    "slug": "deal-mate",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "dealmate",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/87fb83a5-c29e-44ae-af70-f1fe16aa8abf",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "NEVER"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.giatot.tech.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D13A2F"
      },
      "package": "com.giatot.tech.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#FFF6F0"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D13A2F"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "Cho phép DealMate dùng dữ liệu để hiển thị quảng cáo phù hợp hơn với bạn."
        }
      ],
      "./plugins/withAndroidRelease"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "87fb83a5-c29e-44ae-af70-f1fe16aa8abf"
      }
    },
    "owner": "nhutlv"
  }
}
